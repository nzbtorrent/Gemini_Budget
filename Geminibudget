<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monthly Budget Web App</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background-color: #f4f4f4;
            color: #333;
        }
        .container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        }
        h1, h2, h3 {
            color: #2c3e50;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 8px;
            margin-top: 25px;
        }
        .section {
            margin-bottom: 20px;
        }
        .section label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }
        .section input[type="text"],
        .section input[type="number"] {
            width: calc(100% - 22px);
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box; /* Include padding in width */
        }
        .subsection {
            margin-left: 20px;
            border-left: 4px solid #f0f0f0;
            padding-left: 15px;
            margin-bottom: 10px;
        }
        .total-row {
            font-weight: bold;
            background-color: #eaf2f8;
            padding: 15px;
            margin-top: 25px;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .total-row label {
            font-size: 1.2em;
            color: #2c3e50;
        }
        .total-row input {
            background-color: transparent;
            border: none;
            font-weight: bold;
            font-size: 1.2em;
            color: #27ae60; /* Green for positive income */
            width: 150px;
            text-align: right;
        }
        .total-row input.negative {
            color: #e74c3c; /* Red for negative income */
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Monthly Budget Overview</h1>

        <div class="section">
            <label for="month">Budget For:</label>
            <input type="text" id="month" name="month" value="May 2025" onchange="calculateBudget()">
        </div>

        <div class="section">
            <h2>Income</h2>
            <label for="brutoIncome">Bruto Income:</label>
            <input type="number" id="brutoIncome" name="brutoIncome" value="0.00" step="0.01" oninput="calculateBudget()">
        </div>

        <h2>Expenses</h2>

        <div class="section">
            <h3>Housing</h3>
            <div class="subsection">
                <label for="bondExpenses">Bond Expenses: House</label>
                <input type="number" id="bondExpenses" name="bondExpenses" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="homeLoanFNB">Home Loan : FNB</label>
                <input type="number" id="homeLoanFNB" name="homeLoanFNB" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="waterRates">Water & Rates Payments</label>
                <input type="number" id="waterRates" name="waterRates" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="electricity">Electricity</label>
                <input type="number" id="electricity" name="electricity" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="dstv">DsTV</label>
                <input type="number" id="dstv" name="dstv" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="telephoneAccount">Telephone Account</label>
                <input type="number" id="telephoneAccount" name="telephoneAccount" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
        </div>

        <div class="section">
            <h3>Vehicle</h3>
            <div class="subsection">
                <label for="vehicleFinance">Vehicle Finance Incl Add. Insurance & Covers</label>
                <input type="number" id="vehicleFinance" name="vehicleFinance" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="transport">Transport</label>
                <input type="number" id="transport" name="transport" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="vehicleTracking">Vehicle Tracking</label>
                <input type="number" id="vehicleTracking" name="vehicleTracking" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="carMaintenance">Car Maintenance</label>
                <input type="number" id="carMaintenance" name="carMaintenance" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
        </div>

        <div class="section">
            <h3>General & Personal Expenses</h3>
            <div class="subsection">
                <label for="insurance">Insurance (Other than vehicle add-on)</label>
                <input type="number" id="insurance" name="insurance" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="church">Church</label>
                <input type="number" id="church" name="church" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="cellContracts">Cell Contracts</label>
                <input type="number" id="cellContracts" name="cellContracts" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="studies">Studies: (CPUT Btech, Unisa, USB)</label>
                <input type="number" id="studies" name="studies" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="internetUsage">Internet Usage Fee</label>
                <input type="number" id="internetUsage" name="internetUsage" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="bankCosts">Bank Costs</label>
                <input type="number" id="bankCosts" name="bankCosts" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="creditCard">Credit Card</label>
                <input type="number" id="creditCard" name="creditCard" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="rcp">RCP: Recollecting Credit Policy</label>
                <input type="number" id="rcp" name="rcp" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="medicalAid">Medical Aid Contribution, Dr Payment, Medication</label>
                <input type="number" id="medicalAid" name="medicalAid" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="toiletries">Toiletries</label>
                <input type="number" id="toiletries" name="toiletries" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="shops">Shops (Truworths, Markhams)</label>
                <input type="number" id="shops" name="shops" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="pocketMoney">Pocket Money</label>
                <input type="number" id="pocketMoney" name="pocketMoney" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
        </div>

        <div class="section">
            <h3>Occasional & Seasonal Expenses</h3>
            <div class="subsection">
                <label for="birthdays">Birthdays (Cakes, Presents, Parties)</label>
                <input type="number" id="birthdays" name="birthdays" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="christmas">Christmas (Presents, Parties)</label>
                <input type="number" id="christmas" name="christmas" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="festiveTravel">Festive Season Travel Funds (Petrol)</label>
                <input type="number" id="festiveTravel" name="festiveTravel" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
        </div>

        <h2>Savings</h2>
        <div class="section">
            <div class="subsection">
                <label for="emergencySavings">Emergency Savings</label>
                <input type="number" id="emergencySavings" name="emergencySavings" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="fixedSavings">Fixed Savings</label>
                <input type="number" id="fixedSavings" name="fixedSavings" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="retirementSavings">Retirement Savings</label>
                <input type="number" id="retirementSavings" name="retirementSavings" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="funeralSavings">Funeral Savings</label>
                <input type="number" id="funeralSavings" name="funeralSavings" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
        </div>

        <h2>Financial Planning</h2>
        <div class="section">
            <div class="subsection">
                <label for="educationPlan">Education Plan (CPUT, Unisa, USB)</label>
                <input type="number" id="educationPlan" name="educationPlan" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="electronics">Electronics (Tablet, Phone)</label>
                <input type="number" id="electronics" name="electronics" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="carDeposit">Car Deposit / Balloon Settlement</label>
                <input type="number" id="carDeposit" name="carDeposit" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="computerHardware">Computer Hardware & Software</label>
                <input type="number" id="computerHardware" name="computerHardware" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="appliances">Appliances: (TV, Decoders, Microwaves)</label>
                <input type="number" id="appliances" name="appliances" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="iiaMembership">IIA Membership</label>
                <input type="number" id="iiaMembership" name="iiaMembership" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="vacation">Vacation</label>
                <input type="number" id="vacation" name="vacation" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="housePurchase">House Purchase</label>
                <input type="number" id="housePurchase" name="housePurchase" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="babyExpenses">Baby Expenses</label>
                <input type="number" id="babyExpenses" name="babyExpenses" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="weddingExpenses">Wedding Expenses</label>
                <input type="number" id="weddingExpenses" name="weddingExpenses" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="loanAccount">Loan Account (General)</label>
                <input type="number" id="loanAccount" name="loanAccount" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
        </div>

        <h2>Debt</h2>
        <div class="section">
            <div class="subsection">
                <label for="cellPhonePurchased">Cell Phone Purchased (Debt Repayment)</label>
                <input type="number" id="cellPhonePurchased" name="cellPhonePurchased" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="loanSettlement">Loan Settlement</label>
                <input type="number" id="loanSettlement" name="loanSettlement" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
            <div class="subsection">
                <label for="interestReimbursement">Interest Re-Imbursement (Paid Out)</label>
                <input type="number" id="interestReimbursement" name="interestReimbursement" value="0.00" step="0.01" oninput="calculateBudget()">
            </div>
        </div>

        ---

        <div class="total-row">
            <label for="disposableIncome">Disposable Income:</label>
            <input type="text" id="disposableIncome" name="disposableIncome" value="R 0.00" readonly>
        </div>

        <script>
            function calculateBudget() {
                const brutoIncome = parseFloat(document.getElementById('brutoIncome').value) || 0;

                // Sum all expenses
                const expenses = [
                    'bondExpenses', 'homeLoanFNB', 'waterRates', 'electricity', 'dstv', 'telephoneAccount',
                    'vehicleFinance', 'transport', 'vehicleTracking', 'carMaintenance',
                    'insurance', 'church', 'cellContracts', 'studies', 'internetUsage', 'bankCosts',
                    'creditCard', 'rcp', 'medicalAid', 'toiletries', 'shops', 'pocketMoney',
                    'birthdays', 'christmas', 'festiveTravel',
                    'emergencySavings', 'fixedSavings', 'retirementSavings', 'funeralSavings',
                    'educationPlan', 'electronics', 'carDeposit', 'computerHardware', 'appliances',
                    'iiaMembership', 'vacation', 'housePurchase', 'babyExpenses', 'weddingExpenses', 'loanAccount',
                    'cellPhonePurchased', 'loanSettlement', 'interestReimbursement'
                ];

                let totalExpenses = 0;
                expenses.forEach(id => {
                    totalExpenses += parseFloat(document.getElementById(id).value) || 0;
                });

                const disposableIncome = brutoIncome - totalExpenses;
                const disposableIncomeInput = document.getElementById('disposableIncome');

                disposableIncomeInput.value = 'R ' + disposableIncome.toFixed(2);

                // Change color based on disposable income
                if (disposableIncome < 0) {
                    disposableIncomeInput.classList.add('negative');
                } else {
                    disposableIncomeInput.classList.remove('negative');
                }
            }

            // Call calculateBudget initially to set the correct values
            document.addEventListener('DOMContentLoaded', calculateBudget);
        </script>
    </div>
</body>
</html>
